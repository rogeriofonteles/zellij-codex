#!/usr/bin/env python3
"""Apply one lifecycle report to native Zellij titles; no resident monitor."""

import argparse
import fcntl
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).parent))
import zellij_codex_binding as binding

BADGES = {
    "running": "[🟠 ↻] ",
    "input": "[🔴 !] ",
    "done": "[🔵 ✓] ",
    "hold": "[🟡 ⚑] ",
    "stuck": "[🟡 !] ",
    "error": "[🔴 ✕] ",
    "paused": "[🟡 ⚑] ",
    "idle": "[⚪ ○] ",
}
PRIORITY = {
    "idle": 0,
    "paused": 2,
    "running": 3,
    "done": 4,
    "stuck": 5,
    "error": 6,
    "input": 7,
}


def badge_title(title: str, status: str | None) -> str:
    for badge in (*BADGES.values(), "[🔴 ↻] ", "[🟡 !] ", "[🟡 Ⅱ] ", "[🟡 Ⅱ ] ", "[🟡⏸︎] ", "[🟡⏸] ", "[🟡‖] "):
        if badge and title.startswith(badge):
            title = title[len(badge) :]
            break
    return (BADGES[status] if status is not None else "") + title


def reconcile(
    state: dict[str, Any], panes: list[dict[str, Any]], report: dict[str, Any]
) -> tuple[dict[str, Any], list[list[str]]]:
    """Plan only changed titles, resolving pane locations from the live manifest."""
    if "clear_done_pane_id" in report:
        selected = str(report["clear_done_pane_id"])
        if (
            state.get("statuses", {}).get(selected) != "done"
            and selected not in state.get("on_hold", [])
        ):
            return state, []
    live = {str(p["id"]): p for p in panes if not p["is_plugin"] and not p["exited"]}
    statuses = {
        key: value for key, value in state.get("statuses", {}).items() if key in live
    }
    waiting = {
        key: value for key, value in state.get("waiting", {}).items() if key in live
    }
    threads = {key: value for key, value in state.get("threads", {}).items() if key in live}
    on_hold = set(state.get("on_hold", [])) & live.keys()
    clear_pane = str(report.get("clear_done_pane_id", ""))
    if clear_pane in live and clear_pane in on_hold:
        on_hold.discard(clear_pane)
        statuses.pop(clear_pane, None)
        waiting.pop(clear_pane, None)
    elif clear_pane in live and statuses.get(clear_pane) == "done":
        statuses[clear_pane] = "idle"
        waiting.pop(clear_pane, None)
    hold_pane = str(report.get("toggle_hold_pane_id", ""))
    if hold_pane in statuses:
        on_hold.symmetric_difference_update({hold_pane})
    pane_id = str(report.get("pane_id", ""))
    if pane_id in live:
        if (
            report.get("remove")
            or report.get("event") in ("UserPromptSubmit", "SessionStart")
            or (report.get("binding_prefix") and report["binding_prefix"] != threads.get(pane_id))
        ):
            on_hold.discard(pane_id)
        if report.get("remove"):
            statuses.pop(pane_id, None)
            waiting.pop(pane_id, None)
            threads.pop(pane_id, None)
        elif report.get("status") in BADGES:
            status = report["status"]
            event = report.get("event")
            tool = report.get("tool_name", "")
            pending = waiting.get(pane_id)
            if event == "PermissionRequest" or (
                event == "PreToolUse" and status == "input"
            ):
                waiting[pane_id] = tool
            elif event == "PostToolUse" and pending is not None:
                # Other tools can complete while a question is still open.
                # An asynchronous question stays open while the turn is active.
                if pending != tool or pending.endswith("request_user_input_async"):
                    status = "input"
                else:
                    waiting.pop(pane_id, None)
            else:
                waiting.pop(pane_id, None)
            statuses[pane_id] = status
        if prefix := report.get("binding_prefix"):
            threads[pane_id] = prefix
        if "binding_waiting" in report:
            if report["binding_waiting"] is None:
                waiting.pop(pane_id, None)
            else:
                waiting[pane_id] = report["binding_waiting"]

    actions: list[list[str]] = []
    for key, pane in live.items():
        # Recognizing our own prefix also recovers interrupted writes without
        # accumulating badges or taking ownership of unrelated pane titles.
        title = (report.get("base_title") or pane["title"]) if key == pane_id else pane["title"]
        desired = badge_title(title, "hold" if key in on_hold else statuses.get(key))
        if desired != title:
            actions.append(
                ["rename-pane", "--pane-id", f"terminal_{key}", "--", desired]
            )

    tabs = {str(p["tab_id"]): p["tab_name"] for p in panes}
    tab_statuses = dict.fromkeys(tabs, "idle")
    for key, status in statuses.items():
        if key in on_hold or status == "hold":
            continue
        tab_id = str(live[key]["tab_id"])
        if PRIORITY[status] > PRIORITY[tab_statuses[tab_id]]:
            tab_statuses[tab_id] = status
    for tab_id, title in tabs.items():
        desired = badge_title(title, None if tab_statuses[tab_id] == "idle" else tab_statuses[tab_id])
        if desired != title:
            actions.append(["rename-tab-by-id", tab_id, "--", desired])
    updated: dict[str, Any] = {"statuses": statuses, "waiting": waiting, "threads": threads}
    if on_hold:
        updated["on_hold"] = sorted(on_hold)
    return updated, actions


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--session", default=os.environ.get("ZELLIJ_SESSION_NAME"))
    parser.add_argument(
        "--pane-id",
        type=int,
        default=os.environ.get("ZELLIJ_PANE_ID"),
        help="Terminal pane ID for --clear-done or --toggle-hold (defaults to this pane).",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--refresh",
        action="store_true",
        help="Clear closed panes and recompute badges.",
    )
    mode.add_argument(
        "--clear-done",
        action="store_true",
        help="Clear this pane's completed or hold badge, preserving other states.",
    )
    mode.add_argument(
        "--toggle-hold",
        action="store_true",
        help="Toggle a pane-only yellow hold badge on this tracked pane.",
    )
    args = parser.parse_args()
    if (args.clear_done or args.toggle_hold) and args.pane_id is None:
        parser.error("--clear-done and --toggle-hold require --pane-id or ZELLIJ_PANE_ID")
    if not args.session:
        raise SystemExit(
            "A Zellij session is required (--session or ZELLIJ_SESSION_NAME)."
        )
    report = {} if args.refresh or args.clear_done or args.toggle_hold else json.load(sys.stdin)
    command = ["zellij", "--session", args.session, "action"]
    cache = (
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "zellij-codex/badges"
    )
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    identity = _session_identity(args.session)
    path = cache / f"{identity}.json"
    with (cache / f"{identity}.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = json.loads(path.read_text()) if path.exists() else {}
        if thread_id := report.get("thread_id"):
            clients = [
                item for item in binding.active_bindings()
                if item.get("session") == args.session
                and str(item.get("pane")) == str(report.get("pane_id"))
                and hashlib.sha256(item.get("socket", "").encode()).hexdigest() == identity
            ]
            if clients:
                # Hooks can outlive the conversation displayed by their client.
                # The title registration will recover a new thread's pending events.
                if not any(thread_id.startswith(item["prefix"]) for item in clients):
                    return
                if report.get("event") == "SessionEnd":
                    # The terminal bridge owns removal while its client is attached.
                    report["remove"] = False
                    report["status"] = "idle"
        if prefix := report.get("binding_prefix"):
            # Re-read under the same lock as lifecycle reports. Registration
            # must not overwrite a newer Stop event with a queued running state.
            current = binding.read_json(Path(report["binding_path"]))
            if current.get("prefix") != prefix:
                return
            if state.get("threads", {}).get(str(report.get("pane_id"))) != prefix:
                snapshot = binding.state_for_prefix(prefix)
                report["status"] = snapshot.get("status", "idle")
                report["binding_waiting"] = snapshot.get("waiting")
        panes = json.loads(
            subprocess.check_output(
                [*command, "list-panes", "--all", "--json"],
                text=True,
                timeout=5,
            )
        )
        if args.clear_done:
            report["clear_done_pane_id"] = args.pane_id
        if args.toggle_hold:
            report["toggle_hold_pane_id"] = args.pane_id
        state, actions = reconcile(state, panes, report)
        for action in actions:
            subprocess.run(
                [*command, *action], check=True, capture_output=True, timeout=5
            )
        temporary = path.with_suffix(".tmp")
        temporary.write_text(json.dumps(state) + "\n")
        temporary.replace(path)


def _session_identity(session: str) -> str:
    candidates = [
        Path(os.environ.get("ZELLIJ_SOCKET_DIR", f"/tmp/zellij-{os.getuid()}"))
    ]
    if runtime := os.environ.get("XDG_RUNTIME_DIR"):
        candidates.append(Path(runtime) / "zellij")
    for directory in candidates:
        for contract in directory.glob("contract_version_*"):
            socket = contract / session
            if not socket.is_socket():
                continue
            stat = socket.stat()
            identity = f"{socket}:{stat.st_ino}:{stat.st_mtime_ns}"
            return hashlib.sha256(identity.encode()).hexdigest()
    raise SystemExit(f"Could not find the socket for Zellij session {session!r}.")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Receive authenticated remote Codex reports and forward them to Zellij."""

import argparse
import hmac
import json
import os
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


MAX_BODY = 128 * 1024


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=47832)
    parser.add_argument("--session", default="workbench-v2-agent")
    parser.add_argument(
        "--token-file",
        type=Path,
        default=Path.home() / ".config/zellij-codex/relay-token",
    )
    parser.add_argument(
        "--plugin",
        default=str(
            Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
            / "zellij/plugins/zellij-codex.wasm"
        ),
    )
    args = parser.parse_args()

    token = args.token_file.read_text().strip()
    if not token:
        raise SystemExit(f"empty relay token: {args.token_file}")

    class Handler(BaseHTTPRequestHandler):
        def do_POST(self) -> None:
            supplied = self.headers.get("Authorization", "")
            if self.path != "/report" or not hmac.compare_digest(supplied, f"Bearer {token}"):
                self.send_error(404)
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
                if length < 1 or length > MAX_BODY:
                    raise ValueError("invalid body length")
                body = self.rfile.read(length)
                report = json.loads(body)
                if not isinstance(report, dict):
                    raise ValueError("report must be an object")
                payload = json.dumps(report, separators=(",", ":"))
                result = subprocess.run(
                    [
                        "zellij", "--session", args.session, "pipe",
                        "--plugin", f"file:{args.plugin}",
                        "--name", "codex_status", "--", payload,
                    ],
                    check=False,
                    timeout=3,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                if result.returncode:
                    self.send_error(503, "Zellij session is unavailable")
                    return
            except (ValueError, json.JSONDecodeError):
                self.send_error(400, "invalid report")
                return
            except (OSError, subprocess.TimeoutExpired):
                self.send_error(503, "could not contact Zellij")
                return
            self.send_response(204)
            self.end_headers()

        def log_message(self, format: str, *values: object) -> None:
            print(f"{self.client_address[0]} - {format % values}")

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    print(f"Listening on http://{args.host}:{args.port}/report for session {args.session}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()

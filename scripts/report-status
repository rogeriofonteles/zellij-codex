#!/usr/bin/env python3
"""Send one Codex agent status report to the Zellij plugin."""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "status",
        choices=("running", "idle", "input", "stuck", "error", "done", "paused"),
    )
    parser.add_argument("--agent", default="codex")
    parser.add_argument(
        "--id",
        default=os.environ.get("CODEX_THREAD_ID")
        or f"pane-{os.environ.get('ZELLIJ_PANE_ID', 'manual')}",
    )
    parser.add_argument("--task", default="")
    parser.add_argument("--worktree", default=Path.cwd().name)
    parser.add_argument(
        "--plugin",
        help="Send to the optional legacy dashboard instead of native badges.",
    )
    parser.add_argument("--session", default=os.environ.get("ZELLIJ_SESSION_NAME"))
    parser.add_argument("--pane-id", type=int, default=os.environ.get("ZELLIJ_PANE_ID"))
    args = parser.parse_args()

    payload = json.dumps(
        {
            "id": args.id,
            "agent": args.agent,
            "status": args.status,
            "task": args.task,
            "worktree": args.worktree,
            "pane_id": args.pane_id,
        },
        separators=(",", ":"),
    )
    if args.plugin:
        subprocess.run(
            [
                "zellij",
                "pipe",
                "--plugin",
                f"file:{args.plugin}",
                "--name",
                "codex_status",
                "--",
                payload,
            ],
            check=True,
        )
    else:
        subprocess.run(
            [
                sys.executable,
                str(Path(__file__).with_name("codex-badges")),
                "--session",
                args.session or "",
            ],
            input=payload,
            text=True,
            check=True,
        )


if __name__ == "__main__":
    main()

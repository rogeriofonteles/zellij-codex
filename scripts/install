#!/usr/bin/env python3
"""Install the plugin, lifecycle reporter, and Codex hook registrations."""

import json
import os
import secrets
import shutil
from pathlib import Path


EVENTS = ("SessionStart", "UserPromptSubmit", "PermissionRequest", "Stop", "SessionEnd")


def main() -> None:
    root = Path(__file__).resolve().parents[1]
    source_wasm = root / "target/wasm32-wasip1/release/zellij-codex.wasm"
    if not source_wasm.is_file():
        raise SystemExit("build the release WASM artifact before installing")

    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    plugin = config_home / "zellij/plugins/zellij-codex.wasm"
    hook = Path.home() / ".local/bin/zellij-codex-hook"
    launcher = Path.home() / ".local/bin/zellij-codex-launch"
    receiver = Path.home() / ".local/bin/zellij-codex-receiver"
    relay_token = config_home / "zellij-codex/relay-token"
    fish_function = config_home / "fish/functions/codex.fish"
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    hooks_json = codex_home / "hooks.json"

    plugin.parent.mkdir(parents=True, exist_ok=True)
    hook.parent.mkdir(parents=True, exist_ok=True)
    hooks_json.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source_wasm, plugin)
    shutil.copy2(root / "scripts/codex-hook", hook)
    shutil.copy2(root / "scripts/codex-launch", launcher)
    shutil.copy2(root / "scripts/remote-receiver", receiver)
    hook.chmod(0o755)
    launcher.chmod(0o755)
    receiver.chmod(0o755)
    relay_token.parent.mkdir(parents=True, exist_ok=True)
    if not relay_token.exists():
        relay_token.write_text(secrets.token_urlsafe(32) + "\n")
        relay_token.chmod(0o600)

    # Zellij panes in this setup use fish. A function preserves the normal
    # `codex` command while adding a report before the Codex TUI starts.
    fish_function.parent.mkdir(parents=True, exist_ok=True)
    fish_function.write_text(
        "function codex --description 'Launch Codex with Zellij status reporting'\n"
        "    command zellij-codex-launch $argv\n"
        "end\n"
    )

    document = json.loads(hooks_json.read_text()) if hooks_json.exists() else {}
    hooks = document.setdefault("hooks", {})
    command = str(hook)
    for event in EVENTS:
        groups = hooks.setdefault(event, [])
        groups[:] = [
            group
            for group in groups
            if not any(handler.get("command") == command for handler in group.get("hooks", []))
        ]
        groups.append({"hooks": [{"type": "command", "command": command}]})

    temporary = hooks_json.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(document, indent=2) + "\n")
    temporary.replace(hooks_json)

    print(f"plugin: {plugin}")
    print(f"hook reporter: {hook}")
    print(f"launch reporter: {launcher}")
    print(f"remote receiver: {receiver}")
    print(f"remote relay token: {relay_token}")
    print(f"fish integration: {fish_function}")
    print(f"Codex hooks: {hooks_json}")
    print("Open a new Codex instance and run /hooks once to review and enable the hooks.")


if __name__ == "__main__":
    main()

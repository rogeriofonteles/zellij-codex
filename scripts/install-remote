#!/usr/bin/env python3
"""Install the remote Codex hook and its relay configuration."""

import argparse
import getpass
import json
import shutil
from pathlib import Path


EVENTS = ("SessionStart", "UserPromptSubmit", "PermissionRequest", "Stop", "SessionEnd")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--token", help="relay token (omit to enter it without shell-history exposure)")
    parser.add_argument("--host", help="label shown before codex in the dashboard")
    parser.add_argument("--url", default="http://127.0.0.1:47832/report")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    hook = Path.home() / ".local/bin/zellij-codex-remote-hook"
    config = Path.home() / ".config/zellij-codex/remote.json"
    hooks_json = Path.home() / ".codex/hooks.json"
    hook.parent.mkdir(parents=True, exist_ok=True)
    config.parent.mkdir(parents=True, exist_ok=True)
    hooks_json.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(root / "scripts/remote-hook", hook)
    hook.chmod(0o755)
    token = args.token or getpass.getpass("Local relay token: ").strip()
    if not token:
        raise SystemExit("relay token cannot be empty")
    remote_config = {"url": args.url, "token": token}
    if args.host:
        remote_config["host"] = args.host
    config.write_text(json.dumps(remote_config, indent=2) + "\n")
    config.chmod(0o600)

    document = json.loads(hooks_json.read_text()) if hooks_json.exists() else {}
    hooks = document.setdefault("hooks", {})
    command = str(hook)
    for event in EVENTS:
        groups = hooks.setdefault(event, [])
        groups[:] = [
            group for group in groups
            if not any(item.get("command") == command for item in group.get("hooks", []))
        ]
        groups.append({"hooks": [{"type": "command", "command": command}]})
    temporary = hooks_json.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(document, indent=2) + "\n")
    temporary.replace(hooks_json)
    print(f"remote hook: {hook}")
    print(f"relay config: {config}")
    print(f"Codex hooks: {hooks_json}")
    print("Start a new Codex instance and approve the hooks when prompted.")


if __name__ == "__main__":
    main()

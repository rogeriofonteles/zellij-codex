#!/usr/bin/env python3
"""Register a Codex pane immediately, then replace this process with Codex."""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path


def pane_context(cwd: Path) -> tuple[str, int | None, int | None]:
    panes = _list_panes()
    pane = os.environ.get("ZELLIJ_PANE_ID") or os.environ.get(
        "ZELLIJ_CODEX_PANE_ID", ""
    )
    if pane.isdigit():
        tab_id, tab_position = _pane_location(panes, int(pane))
        return pane, tab_id, tab_position

    candidates = [
        pane_info
        for pane_info in panes
        if _is_launcher_pane(pane_info) and _pane_cwd(pane_info) == cwd.resolve()
    ]
    running_candidates = [
        pane_info
        for pane_info in candidates
        if _command_contains_launcher(pane_info.get("pane_command"))
    ]
    if running_candidates:
        candidates = running_candidates
    if len(candidates) != 1:
        return "", None, None

    pane_info = candidates[0]
    pane_id = pane_info.get("id")
    if not isinstance(pane_id, int):
        return "", None, None
    tab_id = pane_info.get("tab_id")
    tab_position = pane_info.get("tab_position")
    return (
        str(pane_id),
        tab_id if isinstance(tab_id, int) else None,
        tab_position if isinstance(tab_position, int) else None,
    )


def configure_pane_identity(
    pane: str, tab_id: int | None, tab_position: int | None
) -> None:
    if not pane:
        return
    os.environ["ZELLIJ_CODEX_PANE_ID"] = pane
    if tab_id is not None:
        os.environ["ZELLIJ_CODEX_TAB_ID"] = str(tab_id)
    if tab_position is not None:
        os.environ["ZELLIJ_CODEX_TAB_POSITION"] = str(tab_position)


def codex_arguments(args: list[str], cwd: Path) -> list[str]:
    trust_override = _linked_worktree_trust_override(cwd)
    if trust_override is None:
        return args
    return ["--config", trust_override, *args]


def restore_zellij_socket_dir() -> str | None:
    socket_dir = os.environ.get("ZELLIJ_SOCKET_DIR")
    if socket_dir:
        return socket_dir

    session = os.environ.get("ZELLIJ_SESSION_NAME")
    if not session:
        return None

    for candidate in _zellij_socket_dir_candidates():
        try:
            contract_dirs = candidate.glob("contract_version_*")
            if not any(
                (contract_dir / session).exists() for contract_dir in contract_dirs
            ):
                continue
        except OSError:
            continue
        socket_dir = str(candidate)
        os.environ["ZELLIJ_SOCKET_DIR"] = socket_dir
        return socket_dir
    return None


def _zellij_socket_dir_candidates() -> list[Path]:
    candidates: list[Path] = []
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir:
        candidates.append(Path(runtime_dir) / "zellij")
    if hasattr(os, "getuid"):
        candidates.append(Path(tempfile.gettempdir()) / f"zellij-{os.getuid()}")
    return list(dict.fromkeys(candidates))


def _list_panes() -> list[dict[str, object]]:
    try:
        result = subprocess.run(
            ["zellij", "action", "list-panes", "--all", "--json"],
            check=False,
            capture_output=True,
            text=True,
            timeout=1,
        )
        panes = json.loads(result.stdout) if result.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return []
    if not isinstance(panes, list):
        return []
    return [pane_info for pane_info in panes if isinstance(pane_info, dict)]


def _pane_location(
    panes: list[dict[str, object]], pane_id: int
) -> tuple[int | None, int | None]:
    for pane_info in panes:
        if not pane_info.get("is_plugin", False) and pane_info.get("id") == pane_id:
            tab_id = pane_info.get("tab_id")
            tab_position = pane_info.get("tab_position")
            return (
                tab_id if isinstance(tab_id, int) else None,
                tab_position if isinstance(tab_position, int) else None,
            )
    return None, None


def _pane_cwd(pane_info: dict[str, object]) -> Path | None:
    pane_cwd = pane_info.get("pane_cwd")
    if not isinstance(pane_cwd, str):
        return None
    return Path(pane_cwd).resolve()


def _is_launcher_pane(pane_info: dict[str, object]) -> bool:
    if pane_info.get("is_plugin", False) or pane_info.get("exited", False):
        return False
    commands = (pane_info.get("pane_command"), pane_info.get("terminal_command"))
    return any(_command_contains_launcher(command) for command in commands)


def _command_contains_launcher(command: object) -> bool:
    return isinstance(command, str) and any(
        Path(token.strip("'\";|&()")).name == "zellij-codex-launch"
        for token in command.split()
    )


def _linked_worktree_trust_override(cwd: Path) -> str | None:
    worktrees = _git_worktrees(cwd)
    if len(worktrees) < 2:
        return None

    resolved_cwd = cwd.resolve()
    current = next(
        (
            worktree
            for worktree in worktrees
            if resolved_cwd == worktree or worktree in resolved_cwd.parents
        ),
        None,
    )
    primary = worktrees[0]
    if current is None or current == primary:
        return None

    projects = _codex_projects()
    if _project_is_trusted(projects, current) or not _project_is_trusted(
        projects, primary
    ):
        return None

    project_key = json.dumps(str(current))
    return f'projects.{project_key}.trust_level="trusted"'


def _git_worktrees(cwd: Path) -> list[Path]:
    try:
        result = subprocess.run(
            ["git", "-C", str(cwd), "worktree", "list", "--porcelain"],
            check=False,
            capture_output=True,
            text=True,
            timeout=1,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if result.returncode != 0:
        return []
    return [
        Path(line.removeprefix("worktree ")).resolve()
        for line in result.stdout.splitlines()
        if line.startswith("worktree ")
    ]


def _codex_projects() -> dict[str, object]:
    config_root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    try:
        with (config_root / "config.toml").open("rb") as config_file:
            projects = tomllib.load(config_file).get("projects", {})
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    if not isinstance(projects, dict):
        return {}
    return projects


def _project_is_trusted(projects: dict[str, object], path: Path) -> bool:
    for project_path, settings in projects.items():
        if (
            isinstance(settings, dict)
            and settings.get("trust_level") == "trusted"
            and Path(project_path).resolve() == path
        ):
            return True
    return False


def report_launch(pane: str, tab_id: int | None, tab_position: int | None) -> None:
    if not pane:
        return
    session = os.environ.get("ZELLIJ_SESSION_NAME", "")
    plugin = (
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        / "zellij/plugins/zellij-codex.wasm"
    )
    payload = {
        "id": f"{session}:pane:{pane}" if session else f"pane:{pane}",
        "agent": f"codex-{pane}",
        "status": "idle",
        "task": "Starting Codex",
        "worktree": Path.cwd().name,
        "pane_id": int(pane) if pane.isdigit() else None,
        "tab_id": tab_id,
        "tab_position": tab_position,
    }
    try:
        subprocess.run(
            [
                "zellij",
                "pipe",
                "--plugin",
                f"file:{plugin}",
                "--name",
                "codex_status",
                "--",
                json.dumps(payload, separators=(",", ":")),
            ],
            check=False,
            timeout=2,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def main() -> None:
    restore_zellij_socket_dir()
    cwd = Path.cwd()
    pane, tab_id, tab_position = pane_context(cwd)
    configure_pane_identity(pane, tab_id, tab_position)
    report_launch(pane, tab_id, tab_position)
    executable = shutil.which("codex")
    if not executable:
        raise SystemExit("codex executable not found")
    os.execv(executable, ["codex", *codex_arguments(sys.argv[1:], cwd)])


if __name__ == "__main__":
    main()

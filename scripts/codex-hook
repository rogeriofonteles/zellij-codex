#!/usr/bin/env python3
"""Translate a Codex lifecycle hook on stdin into a Zellij agent report."""

import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
import zellij_codex_binding as binding


def status_for(event: str, payload: dict | None = None) -> str:
    if event == "PreToolUse" and "request_user_input" in str(
        (payload or {}).get("tool_name", "")
    ):
        return "input"
    return {
        "SessionStart": "idle",
        "UserPromptSubmit": "running",
        "PermissionRequest": "input",
        "Stop": "done",
        "SessionEnd": "done",
    }.get(event, "running")


def task_for(event: str, payload: dict) -> str:
    if event == "UserPromptSubmit":
        return str(payload.get("prompt", ""))
    if event == "PermissionRequest":
        return f"Approval needed: {payload.get('tool_name', 'tool')}"
    if event == "Stop":
        return str(payload.get("last_assistant_message") or "Waiting for input")
    if event == "SessionEnd":
        return f"Session ended: {payload.get('reason', 'unknown')}"
    return "New Codex conversation"


def restore_pane_environment(proc_root: Path = Path("/proc")) -> None:
    """Recover only the owning Codex process's pane, never a same-cwd guess.

    Hook runners can supply a sanitized environment. On Linux the parent
    Codex still has its original launch environment, including inside a PTY
    bridge such as codex-latex. Stop at the nearest Codex, even if it has no
    pane (for example the desktop app).
    """
    if os.environ.get("ZELLIJ_SESSION_NAME") and os.environ.get("ZELLIJ_PANE_ID"):
        return
    pid = os.getppid()
    seen = set()
    for _ in range(32):
        if pid <= 1 or pid in seen:
            return
        seen.add(pid)
        process = proc_root / str(pid)
        try:
            executable = (process / "exe").readlink().name.removesuffix(" (deleted)")
            if executable == "codex":
                environment = dict(
                    item.split("=", 1)
                    for item in (process / "environ").read_text().split("\0")
                    if "=" in item
                )
                session = environment.get("ZELLIJ_SESSION_NAME", "")
                pane = environment.get("ZELLIJ_PANE_ID", "")
                if session and pane.isdigit():
                    os.environ["ZELLIJ_SESSION_NAME"] = session
                    os.environ["ZELLIJ_PANE_ID"] = pane
                    os.environ["ZELLIJ_CODEX_PANE_ID"] = pane
                    if socket_dir := environment.get("ZELLIJ_SOCKET_DIR"):
                        os.environ["ZELLIJ_SOCKET_DIR"] = socket_dir
                return
            pid = int((process / "stat").read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return


def restore_zellij_socket_dir() -> str | None:
    socket_dir = os.environ.get("ZELLIJ_SOCKET_DIR")
    if socket_dir:
        return socket_dir

    session = os.environ.get("ZELLIJ_SESSION_NAME")
    if not session:
        return None

    for candidate in _zellij_socket_dir_candidates():
        try:
            contract_dirs = candidate.glob("contract_version_*")
            if not any(
                (contract_dir / session).exists() for contract_dir in contract_dirs
            ):
                continue
        except OSError:
            continue
        socket_dir = str(candidate)
        os.environ["ZELLIJ_SOCKET_DIR"] = socket_dir
        return socket_dir
    return None


def _zellij_socket_dir_candidates() -> list[Path]:
    candidates: list[Path] = []
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir:
        candidates.append(Path(runtime_dir) / "zellij")
    if hasattr(os, "getuid"):
        candidates.append(Path(tempfile.gettempdir()) / f"zellij-{os.getuid()}")
    return list(dict.fromkeys(candidates))


def pane_context(cwd: Path) -> tuple[str, str, int | None, int | None]:
    requested_session = os.environ.get("ZELLIJ_SESSION_NAME", "")
    session_panes = (
        [(requested_session, _list_panes(requested_session))]
        if requested_session
        else [(session, _list_panes(session)) for session in _list_sessions()]
    )
    if not session_panes and os.environ.get("ZELLIJ"):
        session_panes = [("", _list_panes(""))]

    pane = os.environ.get("ZELLIJ_CODEX_PANE_ID") or os.environ.get(
        "ZELLIJ_PANE_ID", ""
    )
    candidates = [
        (session, pane_info)
        for session, panes in session_panes
        for pane_info in panes
        if (
            not pane_info.get("is_plugin", False)
            and not pane_info.get("exited", False)
            and (
                _pane_cwd(pane_info) == cwd.resolve()
                or (
                    _pane_cwd(pane_info) is None
                    and bool(requested_session)
                    and pane.isdigit()
                )
            )
            and (
                pane_info.get("id") == int(pane)
                if pane.isdigit()
                else _is_codex_pane(pane_info)
            )
        )
    ]
    if len(candidates) != 1:
        return "", "", None, None

    session, pane_info = candidates[0]
    pane_id = pane_info.get("id")
    if not isinstance(pane_id, int):
        return "", "", None, None
    tab_id = pane_info.get("tab_id")
    tab_position = pane_info.get("tab_position")
    if pane.isdigit():
        return (
            session,
            pane,
            tab_id
            if isinstance(tab_id, int)
            else _environment_int("ZELLIJ_CODEX_TAB_ID"),
            tab_position
            if isinstance(tab_position, int)
            else _environment_int("ZELLIJ_CODEX_TAB_POSITION"),
        )
    return (
        session,
        str(pane_id),
        tab_id if isinstance(tab_id, int) else None,
        tab_position if isinstance(tab_position, int) else None,
    )


def _list_sessions() -> list[str]:
    try:
        result = subprocess.run(
            ["zellij", "list-sessions", "--short"],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if result.returncode != 0:
        return []
    return [session for line in result.stdout.splitlines() if (session := line.strip())]


def _list_panes(session: str) -> list[dict[str, object]]:
    command = ["zellij"]
    if session:
        command.extend(["--session", session])
    command.extend(["action", "list-panes", "--all", "--json"])
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
        panes = json.loads(result.stdout) if result.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return []
    if not isinstance(panes, list):
        return []
    return [pane_info for pane_info in panes if isinstance(pane_info, dict)]


def _pane_cwd(pane_info: dict[str, object]) -> Path | None:
    pane_cwd = pane_info.get("pane_cwd")
    if not isinstance(pane_cwd, str):
        return None
    return Path(pane_cwd).resolve()


def _is_codex_pane(pane_info: dict[str, object]) -> bool:
    if pane_info.get("is_plugin", False) or pane_info.get("exited", False):
        return False
    commands = (pane_info.get("pane_command"), pane_info.get("terminal_command"))
    return any(
        Path(token.strip("'\";|&()")).name
        in {"codex", "codex.js", "zellij-codex-launch"}
        for command in commands
        if isinstance(command, str)
        for token in command.split()
    )


def _environment_int(name: str) -> int | None:
    value = os.environ.get(name, "")
    return int(value) if value.isdigit() else None


def session_socket_identity(session: str) -> str | None:
    directories = _zellij_socket_dir_candidates()
    if directory := os.environ.get("ZELLIJ_SOCKET_DIR"):
        directories.insert(0, Path(directory))
    for directory in directories:
        for contract in directory.glob("contract_version_*"):
            socket = contract / session
            try:
                if socket.is_socket():
                    stat = socket.stat()
                    return f"{socket.resolve()}:{stat.st_ino}:{stat.st_mtime_ns}"
            except OSError:
                continue
    return None


def session_pane_context(cwd: Path, session_id: str) -> tuple[str, str, int | None, int | None]:
    bindings = [item for item in binding.active_bindings()
                if item.get("socket") == session_socket_identity(item.get("session", ""))]
    matches = [item for item in bindings
               if len(item.get("prefix", "")) >= 29 and session_id.startswith(item["prefix"])]
    if matches:
        # One conversation may be open in more than one client. Do not guess
        # which pane should own it when the hook lacks an explicit pane.
        if len(matches) != 1:
            return "", "", None, None
        item = matches[0]
        for pane in _list_panes(item["session"]):
            if (str(pane.get("id")) == item["pane"] and not pane.get("is_plugin")
                    and not pane.get("exited")):
                return item["session"], item["pane"], pane.get("tab_id"), pane.get("tab_position")
        return "", "", None, None
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "zellij-codex/identities"
    path = cache / (hashlib.sha256(session_id.encode()).hexdigest() + ".json")
    try:
        saved = json.loads(path.read_text())
    except (OSError, ValueError):
        saved = None
    if saved and any(item.get("session") == saved.get("session")
                     and item.get("pane") == saved.get("pane") for item in bindings):
        # The client switched conversations. Its former identity must not
        # update this pane when a background turn completes in the daemon.
        return "", "", None, None
    if saved and not os.environ.get("ZELLIJ_PANE_ID"):
        session = saved["session"]
        if saved["socket"] == session_socket_identity(session):
            for pane in _list_panes(session):
                if (str(pane.get("id")) == saved["pane"]
                    and not pane.get("is_plugin") and not pane.get("exited")
                    and _pane_cwd(pane) in (None, cwd.resolve())):
                    return session, saved["pane"], pane.get("tab_id"), pane.get("tab_position")
    context = pane_context(cwd)
    session, pane, _, _ = context
    if pane and (identity := session_socket_identity(session)):
        try:
            cache.mkdir(parents=True, exist_ok=True, mode=0o700)
            with tempfile.NamedTemporaryFile(mode="w", dir=cache, delete=False) as temporary:
                json.dump({"session": session, "pane": pane, "socket": identity}, temporary)
            os.replace(temporary.name, path)
        except OSError:
            pass
    return context


def main() -> int:
    try:
        payload = json.load(sys.stdin)
        event = str(payload["hook_event_name"])
        session_id = str(payload["session_id"])
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        return 0

    binding.record_event(session_id, event, str(payload.get("tool_name", "")))
    restore_pane_environment()
    restore_zellij_socket_dir()
    cwd = Path(str(payload.get("cwd") or os.getcwd()))
    contexts = active_pane_contexts(session_id)
    if not contexts:
        contexts = [session_pane_context(cwd, session_id)]
    for context in contexts:
        if context[1]:
            send_report(payload, event, session_id, cwd, context)
    return 0


def active_pane_contexts(session_id):
    contexts = []
    manifests = {}
    for item in binding.active_bindings():
        prefix = item.get("prefix", "")
        session = item.get("session", "")
        if len(prefix) < 29 or not session_id.startswith(prefix):
            continue
        if item.get("socket") != session_socket_identity(session):
            continue
        if session not in manifests:
            manifests[session] = _list_panes(session)
        for pane in manifests[session]:
            if (str(pane.get("id")) == item.get("pane") and not pane.get("is_plugin")
                    and not pane.get("exited")):
                contexts.append((session, item["pane"], pane.get("tab_id"), pane.get("tab_position")))
    return list(dict.fromkeys(contexts))


def send_report(payload, event, session_id, cwd, context):
    zellij_session, pane, tab_id, tab_position = context
    report = {
        # The pane identity is available before Codex creates a session. This
        # lets a launch report and later lifecycle hooks update the same row.
        "id": (
            f"{zellij_session}:pane:{pane}"
            if zellij_session and pane
            else f"pane:{pane}"
            if pane
            else session_id
        ),
        "agent": f"codex-{pane}" if pane else f"codex-{session_id[:8]}",
        "status": status_for(event, payload),
        "event": event,
        "tool_name": str(payload.get("tool_name", "")),
        "task": task_for(event, payload),
        "worktree": cwd.name,
        "pane_id": int(pane) if pane.isdigit() else None,
        "tab_id": tab_id,
        "tab_position": tab_position,
        "remove": event == "SessionEnd",
    }
    reporter = Path(__file__).with_name("codex-badges")
    if not reporter.exists():
        reporter = Path(__file__).with_name("zellij-codex-badges")
    command = [sys.executable, str(reporter), "--session", zellij_session]
    try:
        subprocess.run(
            command,
            input=json.dumps(report),
            text=True,
            check=False,
            timeout=20,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

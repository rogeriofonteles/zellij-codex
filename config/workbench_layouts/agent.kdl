layout {
    tab name="agent" focus=true {
        pane size=1 borderless=true {
            plugin location=__TAB_BAR_PLUGIN__
        }
        pane split_direction="vertical" {
            pane size="33%" focus=true name="Terminal"
            pane size="67%" command="env" {
                args "fish" "-lc" "set -e NO_COLOR; if test \"$TERM\" = screen; and infocmp screen-256color >/dev/null 2>&1; set -gx TERM screen-256color; end; if not set -q COLORTERM; set -gx COLORTERM truecolor; end; codex-yolo"
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}

layout {
    tab name=__WORKBENCH_TAB_NAME__ focus=true hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location=__TAB_BAR_PLUGIN__
        }
        pane split_direction="vertical" {
            pane size="33%" focus=true name=__WORKBENCH_PANE_NAME__
            pane size="67%" command="env" {
                args __ZELLIJ_SOCKET_ENV_ARG__ "fish" "-lc" "set -e NO_COLOR; if test \"$TERM\" = screen; and infocmp screen-256color >/dev/null 2>&1; set -gx TERM screen-256color; end; if not set -q COLORTERM; set -gx COLORTERM truecolor; end; codex-yolo"
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
        floating_panes {
            pane x="0%" y=1 width="100%" height="98%" command=__NVIM_WORKBENCH_COMMAND__ {
                args "."
                name "Neovim"
            }
        }
    }
}
